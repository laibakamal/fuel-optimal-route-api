# Copy to .env and edit. Never commit .env.
# Everything here has a working default; .env is optional for SQLite.

# --- Database ---------------------------------------------------------------
# sqlite (default, no external service) or postgres
DB_ENGINE=sqlite
# Only read when DB_ENGINE=postgres
POSTGRES_DB=fuelroute
POSTGRES_USER=fuelroute
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-not-a-real-secret-override-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Vehicle / optimiser ----------------------------------------------------
TANK_CAPACITY_GALLONS=50
MILES_PER_GALLON=10
START_TANK_GALLONS=0
MAX_DETOUR_MILES=10

# --- External routing -------------------------------------------------------
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_FALLBACK_BASE_URL=https://routing.openstreetmap.de/routed-car
# Courtesy identification for the FOSSGIS-sponsored demo servers.
HTTP_USER_AGENT=fuel-route-api/1.0 (backend assessment; contact: see repo README)
ROUTE_CACHE_TTL_SECONDS=86400
